# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# nix
.direnv/
.pre-commit-config.yaml

# rust
target/

# tauri
# Ignore auto-generated schemas
app/src-tauri/gen/schemas/
# Ignore auto-generated plugin permissions
crates/tauri-plugin-*/permissions/autogenerated/
crates/tauri-plugin-*/permissions/schemas/
# Ignore Tauri icons — regenerated by `tauri icon` on build
app/src-tauri/icons/
# Web favicons — regenerated from app/assets/app-icon.png by scripts/gen-icons.sh
app/public/icon-*.png
# Open-source license inventory — regenerated by scripts/gen-licenses.mjs at
# dev/build start (vite plugin). Never hand-edit.
app/public/licenses.json
app/src-tauri/gen/android/app/src/main/res/mipmap-*/
app/src-tauri/gen/android/app/src/main/res/values/ic_launcher_background.xml
# Ignore Android build outputs but keep the scaffolded project
app/src-tauri/gen/android/.gradle/
app/src-tauri/gen/android/app/build/
app/src-tauri/gen/android/app/tauri.build.gradle.kts
app/src-tauri/gen/android/build/
# Ignore build/IDE outputs in local plugin android modules (crates/tauri-plugin-*/android/)
crates/tauri-plugin-*/android/.tauri/
crates/tauri-plugin-*/android/.gradle/
crates/tauri-plugin-*/android/build/
crates/tauri-plugin-*/android/.cxx/
crates/tauri-plugin-*/android/captures/
crates/tauri-plugin-*/android/local.properties
crates/tauri-plugin-*/android/**/*.iml

# Android signing
*.jks
*.keystore
app/src-tauri/gen/android/.keystores/
app/src-tauri/gen/android/keystore.properties

# agentic tools
.claude/worktrees/
.gstack/
.playwright-mcp/
