# npm workspace defaults.
#
# linked: every package resolves through node_modules/.store/<name>@<version>
# with per-package symlinks, so undeclared dependencies stay unreachable
# (the isolation the workspace layout was set up for).
# strict-allow-scripts + engine-strict: install scripts only run for
# packages approved in root package.json under allowScripts, and the
# engines floors are enforced rather than advisory — npm 10 silently
# ignores these keys.
install-strategy=linked
strict-allow-scripts=true
engine-strict=true
