{
  "name": "gpm-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "test": "npm run test -w app",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check ."
  },
  "engines": {
    "node": ">=24.11",
    "npm": ">=11.18"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
