{
  "name": "gpm-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "test": "npm run test -w app",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0"
  },
  "engines": {
    "node": ">=24.11",
    "npm": ">=11.18"
  },
  "dependencies": {
    "prettier-plugin-compact-markdown-table": "^0.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
